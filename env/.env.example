# Copy to env/.env.development and fill required values

APP_NAME=map
NODE_ENV=development
PORT=8000

JWT_ACCESS_EXPIRES_IN_MS=604800000
JWT_ACCESS_SECRET=
JWT_SECURITY_EXPIRES_IN_MS=300000
JWT_SECURITY_SECRET=

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
PICTURES_BUCKET_NAME=

## Resend / Leads (optional — app boots without these)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@your-verified-domain.com
LEAD_NOTIFICATION_EMAILS=sales@example.com
TURNSTILE_SECRET_KEY=
TURNSTILE_OPTIONAL=true
LEAD_IDEMPOTENCY_TTL_HOURS=24
